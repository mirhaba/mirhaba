# Mirhaba environment variables.
# Copy to .env.local for local dev (never commit .env.local). In production, set these in Vercel.
#
# Rule: anything starting with NEXT_PUBLIC_ is shipped to the browser. Never put a secret there.
# Server-only secrets have no prefix and are only read in route handlers / server actions.

# ---------- Site ----------
# Used for canonical URLs, sitemap and Open Graph. On Vercel you can leave it unset until you
# add your own domain: the Vercel production URL is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase ----------
# Local: run `supabase status -o env` and copy API_URL / PUBLISHABLE_KEY / SECRET_KEY.
# Hosted: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Bypasses RLS: use only for webhooks, usage counters and the translation cache.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---------- Auth: Google sign-in ----------
# Google Cloud Console → Credentials → OAuth client (Web).
# Hosted: paste these in Supabase dashboard → Authentication → Providers → Google.
# Local: read by supabase/config.toml ([auth.external.google]).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Shows the "Continue with Google" button. Set to true only once the provider is configured.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# ---------- Bot protection: Cloudflare Turnstile ----------
# Turnstile is only Cloudflare's bot check widget; it works on Vercel (no Cloudflare hosting needed).
# The test keys below always pass. In production use real keys (add your Vercel domain to the
# widget in the Cloudflare dashboard), or leave the site key empty to hide the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------- Email: Resend ----------
# Login codes are sent by Supabase Auth through Resend SMTP (set in the Supabase dashboard);
# receipts and renewal reminders are sent by our server with this key.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Mirhaba <hello@mirhaba.app>"

# ---------- Rate limiting + cache: Upstash Redis ----------
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ---------- Translation brain: Claude (Anthropic) ----------
# Server-only. Get a key at console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5.
TRANSLATION_MODEL=
# Local development without an API key: returns fake "[mock]" translations.
# Ignored on Vercel production. Remove once ANTHROPIC_API_KEY is set.
TRANSLATION_MOCK=
# Hard daily spending cap across AI providers (EUR). Requests stop when reached.
AI_DAILY_SPEND_CAP_EUR=5

# ---------- Speech ----------
# Speech-to-text and text-to-speech providers are still being tested with Prishtina speakers.
STT_API_KEY=
TTS_API_KEY=

# ---------- Payments: RaiAccept (Raiffeisen Bank Kosovo) ----------
# Test + live credentials come from the bank after the website audit.
# Confirm the exact auth scheme and webhook signing method with the bank (see the build plan).
RAIACCEPT_API_URL=
RAIACCEPT_USERNAME=
RAIACCEPT_PASSWORD=
RAIACCEPT_WEBHOOK_SECRET=

# ---------- Analytics: PostHog (EU) ----------
# Loaded only after cookie consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---------- Errors: Sentry ----------
# Error tracking is off while this is empty. Use an EU (de.sentry.io) project.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (uploads source maps so errors show real file names); set in Vercel.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
