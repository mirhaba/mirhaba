{
  "name": "mirhaba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed:generate": "node --experimental-strip-types --no-warnings scripts/generate-seed.ts",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "db:import": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/import-content.ts",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\"",
    "eval": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/translation-eval.ts",
    "eval:check": "node --experimental-strip-types --no-warnings scripts/translation-eval-check.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.16.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "dexie": "^4.4.7",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "posthog-js": "^1.453.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "png-to-ico": "^3.0.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
